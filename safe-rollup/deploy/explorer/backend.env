ETHEREUM_JSONRPC_VARIANT=geth
# Blocks from the sequencer, so new transactions show at once. Traces from the verifier, the archive
# node, which has every historical state; a block not derived from L1 yet is traced on retry.
ETHEREUM_JSONRPC_HTTP_URL=http://host.docker.internal:9547/
ETHEREUM_JSONRPC_TRACE_URL=http://host.docker.internal:9548/
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=true
# Balance history needs historical state on the sequencer, which prunes it. Current balances are
# still fetched on demand.
INDEXER_DISABLE_ADDRESS_COIN_BALANCE_FETCHER=true
INDEXER_INTERNAL_TRANSACTIONS_TRACER_TYPE=call_tracer
CHAIN_TYPE=optimism
CHAIN_ID=11155901
COIN=ETH
COIN_NAME=Ether
NETWORK=Safe Rollup
SUBNETWORK=Sepolia
PORT=4000
ECTO_USE_SSL=false
POOL_SIZE=30
POOL_SIZE_API=10
HEART_BEAT_TIMEOUT=30
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
# Nothing calls out to Blockscout's hosted services or market data providers.
DISABLE_MARKET=true
ACCOUNT_ENABLED=false
ADMIN_PANEL_ENABLED=false
MICROSERVICE_SC_VERIFIER_ENABLED=false
MICROSERVICE_SIG_PROVIDER_ENABLED=false
NFT_MEDIA_HANDLER_ENABLED=false
RE_CAPTCHA_DISABLED=true
