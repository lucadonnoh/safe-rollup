# A Safe rollup on Sepolia, read by init.sh, run.sh and ts/env.ts. Copy it outside the repo, fill in
# fresh keys (cast wallet new), chmod 600, and point SR_ENV at the copy. Keys and data stay on the host.
DATA=/home/donnoh/safe-rollup/data
L1_RPC=https://ethereum-sepolia-rpc.publicnode.com
# Tried in order by the TypeScript services' L1 reads when L1_RPC fails (publicnode rate limits and prunes logs).
L1_RPC_FALLBACKS=https://sepolia.gateway.tenderly.co,https://sepolia.drpc.org
# A finalized start block cannot be reorged out from under the L2 genesis. A relaunch with the same chain
# ID and batcher must start after the previous batcher's last post, or the new chain reads its commitments
# and waits forever for their data: use that block number plus one.
L1_START=finalized
L2_CHAIN_ID=11155901
# The canonical Safe v1.4.1 deployment, so the Safe app and Etherscan recognize the Safe.
SAFE_SINGLETON=0x41675C099F32341bf84BFc5382aF534df5C7461a
SAFE_FACTORY=0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67
OP_NODE_FLAGS="--l1.http-poll-interval 12s --verifier.l1-confs 4"
SEQUENCER_FLAGS="--sequencer.l1-confs 4"
# A batch hash every 10 L1 blocks at most, with fee floors far below the 1 gwei defaults, and caps that
# pause posting during Sepolia fee spikes instead of spending through them.
BATCHER_FLAGS="--max-channel-duration 10 --poll-interval 6s --num-confirmations 2 --sub-safety-margin 10 --resubmission-timeout 120s --txmgr.min-tip-cap 0.01 --txmgr.min-basefee 0.01 --txmgr.max-basefee 2 --txmgr.max-tip-cap 1"
WITHDRAWAL_DELAY=600
VETO_MARGIN_SECONDS=180
POLL_MS=12000
DEMO_ETH=0.001
# No compromised relayer in the public demo: its vetoed payout would show up as a withdrawal.
DEMO_ATTACK=false
STORY_PAUSE=300
# The explorer's public URL. The status page links it and redirects /explorer there.
EXPLORER_URL=
# true once the chain is stopped: the server keeps serving the last status it saved, and nothing else runs.
FROZEN=false

DEPLOYER_KEY=
# Cold keys: the Safe owners, 2 of 3. The watcher holds two of them, which a demo can afford, and
# sends its vetoes from OWNER1, so that one needs ETH.
OWNER1_KEY=
OWNER2_KEY=
OWNER3_KEY=
# Hot keys.
RELAYER_KEY=
RELAYER_ADDR=
BATCHER_KEY=
BATCHER_ADDR=
# The demo user.
USER_KEY=
USER_ADDR=
