# Devnet configuration, read by init.sh, run.sh and ts/env.ts. A deployment on another L1 copies
# this file, points SR_ENV at the copy and replaces the keys (see deploy/sepolia.env.example).
L1_RPC=http://127.0.0.1:8545
L1_CHAIN_CONFIG=devnet/l1-chain-config.json
# L1 block the L2 genesis starts from: latest, finalized on an L1 that can reorg, or a block number.
L1_START=latest
L2_CHAIN_ID=901
OP_NODE_FLAGS="--l1.trustrpc --l1.http-poll-interval 1s --verifier.l1-confs 0"
SEQUENCER_FLAGS="--sequencer.l1-confs 0"
BATCHER_FLAGS="--max-channel-duration 1 --poll-interval 1s --num-confirmations 1 --sub-safety-margin 4 --resubmission-timeout 30s"
WITHDRAWAL_DELAY=30
# The watcher vetoes an unmatched payout this long before its delay ends.
VETO_MARGIN_SECONDS=10
# Relayer and watcher loop interval.
POLL_MS=2000
# demo.ts moves multiples of this many ETH.
DEMO_ETH=1
# demo.ts ends with a compromised relayer queuing a payout that the watcher must veto.
DEMO_ATTACK=true

# Anvil's default test accounts. Devnet only.
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Cold keys: the Safe owners, 2 of 3.
OWNER1_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
OWNER2_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
