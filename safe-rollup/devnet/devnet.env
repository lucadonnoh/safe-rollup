# Hot keys.
RELAYER_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
RELAYER_ADDR=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
